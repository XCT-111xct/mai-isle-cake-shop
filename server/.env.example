# ============================================================
# 文件功能：环境变量模板（这是"样例"，不含任何真实密钥，可以安全提交到 git）
#
# 【怎么用】
#   1. 复制本文件为 .env（同目录下）：
#        Windows:  copy .env.example .env
#        Mac/Linux: cp .env.example .env
#   2. 打开 .env，把 MAI_ISLE_SECRET 换成一个随机长串（命令见下方）
#   3. 重新启动后端即生效
#
# 【为什么要有这个文件】
#   .env 里放的是"每台机器都不一样、且不能公开"的东西（密钥、域名、路径）。
#   .env 已被 .gitignore 忽略，永远不会进 git；
#   而 .env.example 只说明"有哪些配置项"，可以公开。
#   这样别人拿到你的仓库时，看一眼 .env.example 就知道要配什么。
# ============================================================

# ---------- 运行环境 ----------
# dev = 本地开发（默认，不用设）；production = 线上生产
# 【重要】设为 production 后，如果密钥不合格，后端会直接拒绝启动（这是保护机制，不是 bug）
MAI_ISLE_ENV=production

# ---------- JWT 签名密钥（生产环境必填） ----------
# 作用：登录凭证（Token）的签名密钥。泄露 = 任何人都能伪造管理员身份。
# 生成方法（二选一，任选一条命令执行，把输出粘过来）：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#   openssl rand -base64 48
# 要求：至少 32 个字符，越长越好；每次更换后所有已登录用户会被强制登出（这是期望行为）
MAI_ISLE_SECRET=请替换为你自己生成的随机串

# ---------- 调试开关 ----------
# 生产环境必须为 0。
# 设为 1 会同时打开三个危险口子：
#   ① 接口文档页 /docs 对外可访问
#   ② 接口报错时向前端返回详细堆栈（可能泄露表结构、文件路径）
#   ③ 验证码后门：captcha_id=DEMO + captcha=8888 可直接绕过图形验证码登录
MAI_ISLE_DEBUG=0

# ---------- CORS 允许来源 ----------
# 前端域名，多个用英文逗号分隔，不要带结尾斜杠
# 本地开发不设此项即可（默认 localhost:5173 / 5174）
MAI_ISLE_CORS=https://your-domain.com,https://admin.your-domain.com

# ---------- 数据存放路径（可选） ----------
# 不设则默认用项目自带的 server/uploads 与 database/mai_isle.db
# 线上建议改成代码目录之外的位置（重新部署代码时不会覆盖数据）
# MAI_ISLE_UPLOAD_DIR=/var/www/mai-isle-data/uploads
# MAI_ISLE_DB_PATH=/var/www/mai-isle-data/mai_isle.db

# ---------- 监听端口（可选） ----------
# MAI_ISLE_PORT=8000
